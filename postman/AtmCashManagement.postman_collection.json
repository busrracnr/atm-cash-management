{
  "info": {
    "name": "ATM Cash Management",
    "description": "End-to-end scenario, run in order (Collection Runner or newman):\ncreate ATM → configure cassettes → load cash → put in service → request quote → confirm → deposit → switch to maintenance → reconcile → report.\n\nRequires the API from `docker compose up` (baseUrl defaults to http://localhost:8088). Each request asserts its expected result.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8088"
    },
    {
      "key": "user",
      "value": "ops.alice"
    },
    {
      "key": "atmId",
      "value": ""
    },
    {
      "key": "quoteId",
      "value": ""
    },
    {
      "key": "idempotencyKey",
      "value": ""
    },
    {
      "key": "firstConfirmation",
      "value": ""
    },
    {
      "key": "reconciliationId",
      "value": ""
    },
    {
      "key": "approver",
      "value": "ops.bob"
    }
  ],
  "item": [
    {
      "name": "00 Health check",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('API and database are healthy', () => {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(pm.response.json().status).to.eql('Healthy');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/health"
      }
    },
    {
      "name": "01 Create ATM",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('ATM is created as UNCONFIGURED', () => {",
              "  pm.response.to.have.status(201);",
              "  const atm = pm.response.json();",
              "  pm.expect(atm.status).to.eql('UNCONFIGURED');",
              "  pm.collectionVariables.set('atmId', atm.id);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-User",
            "value": "{{user}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"code\": \"ATM-{{$timestamp}}\",\n  \"location\": \"Kadıköy, İstanbul\"\n}"
        },
        "url": "{{baseUrl}}/api/atms"
      }
    },
    {
      "name": "02 Configure cassettes",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Five cassettes are configured', () => {",
              "  pm.response.to.have.status(200);",
              "  const atm = pm.response.json();",
              "  pm.expect(atm.status).to.eql('CONFIGURED');",
              "  pm.expect(atm.cassettes).to.have.lengthOf(5);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-User",
            "value": "{{user}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"cassettes\": [\n    { \"slot\": 1, \"type\": \"DEPOSIT\" },\n    { \"slot\": 2, \"type\": \"RECYCLING\", \"currency\": \"TRY\", \"denomination\": 100 },\n    { \"slot\": 3, \"type\": \"RECYCLING\", \"currency\": \"TRY\", \"denomination\": 50 },\n    { \"slot\": 4, \"type\": \"RECYCLING\", \"currency\": \"TRY\", \"denomination\": 20 },\n    { \"slot\": 5, \"type\": \"RECYCLING\", \"currency\": \"USD\", \"denomination\": 100 }\n  ]\n}"
        },
        "url": "{{baseUrl}}/api/atms/{{atmId}}/cassettes"
      }
    },
    {
      "name": "03 Load cash",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Cash is recorded and the ATM is LOADED', () => {",
              "  pm.response.to.have.status(200);",
              "  const atm = pm.response.json();",
              "  pm.expect(atm.status).to.eql('LOADED');",
              "  pm.expect(atm.cassettes.find(c => c.slot === 2).noteCount).to.eql(50);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-User",
            "value": "{{user}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"items\": [\n    { \"slot\": 2, \"count\": 50 },\n    { \"slot\": 3, \"count\": 40 },\n    { \"slot\": 4, \"count\": 30 },\n    { \"slot\": 5, \"count\": 20 }\n  ]\n}"
        },
        "url": "{{baseUrl}}/api/atms/{{atmId}}/cash-loads"
      }
    },
    {
      "name": "04 Put in service",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('ATM is IN_SERVICE', () => {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(pm.response.json().status).to.eql('IN_SERVICE');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-User",
            "value": "{{user}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"IN_SERVICE\"\n}"
        },
        "url": "{{baseUrl}}/api/atms/{{atmId}}/status"
      }
    },
    {
      "name": "05 Request withdrawal quote",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('160 TRY can be paid exactly; notes are reserved', () => {",
              "  pm.response.to.have.status(201);",
              "  const quote = pm.response.json();",
              "  pm.expect(quote.status).to.eql('OPEN');",
              "  pm.expect(quote.exact.amount).to.eql(160);",
              "  pm.collectionVariables.set('quoteId', quote.quoteId);",
              "  pm.collectionVariables.set('idempotencyKey', pm.variables.replaceIn('{{$guid}}'));",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-User",
            "value": "{{user}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"cardNumber\": \"4111 1111 1111 1111\",\n  \"currency\": \"TRY\",\n  \"amount\": 160\n}"
        },
        "url": "{{baseUrl}}/api/atms/{{atmId}}/withdrawal-quotes"
      }
    },
    {
      "name": "06 Confirm withdrawal",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('The quote is paid out', () => {",
              "  pm.response.to.have.status(200);",
              "  const paid = pm.response.json();",
              "  pm.expect(paid.status).to.eql('CONFIRMED');",
              "  pm.expect(paid.amount).to.eql(160);",
              "  pm.collectionVariables.set('firstConfirmation', pm.response.text());",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-User",
            "value": "{{user}}"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{idempotencyKey}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"option\": \"EXACT\"\n}"
        },
        "url": "{{baseUrl}}/api/withdrawal-quotes/{{quoteId}}/confirm"
      }
    },
    {
      "name": "06b Confirm again with the same Idempotency-Key",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Same result, nothing paid twice', () => {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(pm.response.text()).to.eql(pm.collectionVariables.get('firstConfirmation'));",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-User",
            "value": "{{user}}"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{idempotencyKey}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"option\": \"EXACT\"\n}"
        },
        "url": "{{baseUrl}}/api/withdrawal-quotes/{{quoteId}}/confirm"
      }
    },
    {
      "name": "07 Deposit",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Matching notes go to recycling cassettes, the rest to the deposit cassette', () => {",
              "  pm.response.to.have.status(200);",
              "  const deposit = pm.response.json();",
              "  const slotOf = (cur, den) => deposit.placements.find(p => p.currency === cur && p.denomination === den).slot;",
              "  pm.expect(slotOf('TRY', 100)).to.eql(2);",
              "  pm.expect(slotOf('TRY', 500)).to.eql(1);",
              "  pm.expect(slotOf('EUR', 50)).to.eql(1);",
              "  pm.expect(deposit.unrecognizedReturned).to.eql(1);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-User",
            "value": "{{user}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"notes\": [\n    { \"currency\": \"TRY\", \"denomination\": 100, \"count\": 5 },\n    { \"currency\": \"TRY\", \"denomination\": 500, \"count\": 2 },\n    { \"currency\": \"EUR\", \"denomination\": 50, \"count\": 3 }\n  ],\n  \"unrecognizedCount\": 1\n}"
        },
        "url": "{{baseUrl}}/api/atms/{{atmId}}/deposits"
      }
    },
    {
      "name": "08 Switch to maintenance",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('ATM is in MAINTENANCE', () => {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(pm.response.json().status).to.eql('MAINTENANCE');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-User",
            "value": "{{user}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"MAINTENANCE\"\n}"
        },
        "url": "{{baseUrl}}/api/atms/{{atmId}}/status"
      }
    },
    {
      "name": "09 Reconcile (counted by the first user)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Differences above 1,000 TRY wait for approval', () => {",
              "  pm.response.to.have.status(201);",
              "  const rec = pm.response.json();",
              "  pm.expect(rec.status).to.eql('AWAITING_APPROVAL');",
              "  pm.expect(rec.totalDifferenceTry).to.be.above(1000);",
              "  pm.collectionVariables.set('reconciliationId', rec.reconciliationId);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-User",
            "value": "{{user}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"cassettes\": [\n    { \"slot\": 1, \"notes\": [\n      { \"currency\": \"TRY\", \"denomination\": 500, \"count\": 2 },\n      { \"currency\": \"EUR\", \"denomination\": 50, \"count\": 3 }\n    ] },\n    { \"slot\": 2, \"count\": 52 },\n    { \"slot\": 3, \"count\": 40 },\n    { \"slot\": 4, \"count\": 27 },\n    { \"slot\": 5, \"count\": 19 }\n  ]\n}"
        },
        "url": "{{baseUrl}}/api/atms/{{atmId}}/reconciliations"
      }
    },
    {
      "name": "09a Return to service is blocked until approval",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Rejected with RECONCILIATION_AWAITING_APPROVAL', () => {",
              "  pm.response.to.have.status(409);",
              "  pm.expect(pm.response.json().errorCode).to.eql('RECONCILIATION_AWAITING_APPROVAL');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-User",
            "value": "{{user}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"IN_SERVICE\"\n}"
        },
        "url": "{{baseUrl}}/api/atms/{{atmId}}/status"
      }
    },
    {
      "name": "09b The same user cannot approve",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Rejected with FOUR_EYES_VIOLATION', () => {",
              "  pm.response.to.have.status(403);",
              "  pm.expect(pm.response.json().errorCode).to.eql('FOUR_EYES_VIOLATION');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-User",
            "value": "{{user}}"
          }
        ],
        "url": "{{baseUrl}}/api/reconciliations/{{reconciliationId}}/approve"
      }
    },
    {
      "name": "09c A second user approves",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Approved by the second user', () => {",
              "  pm.response.to.have.status(200);",
              "  const rec = pm.response.json();",
              "  pm.expect(rec.status).to.eql('APPROVED');",
              "  pm.expect(rec.approvedBy).to.eql(pm.variables.get('approver'));",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-User",
            "value": "{{approver}}"
          }
        ],
        "url": "{{baseUrl}}/api/reconciliations/{{reconciliationId}}/approve"
      }
    },
    {
      "name": "10 Report: ATM balance",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Balance reflects the hand count', () => {",
              "  pm.response.to.have.status(200);",
              "  const total = cur => pm.response.json().totals.find(t => t.currency === cur).amount;",
              "  pm.expect(total('TRY')).to.eql(500 * 2 + 100 * 52 + 50 * 40 + 20 * 27);",
              "  pm.expect(total('USD')).to.eql(100 * 19);",
              "  pm.expect(total('EUR')).to.eql(50 * 3);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/atms/{{atmId}}/balance"
      }
    },
    {
      "name": "11 Ledger: movements",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Loads, the withdrawal and the deposit are in the ledger', () => {",
              "  pm.response.to.have.status(200);",
              "  const types = pm.response.json().map(m => m.type);",
              "  const count = type => types.filter(t => t === type).length;",
              "  pm.expect(count('LOAD')).to.eql(4);",
              "  pm.expect(count('RESERVATION')).to.eql(2);",
              "  pm.expect(count('WITHDRAWAL')).to.eql(2);",
              "  pm.expect(count('DEPOSIT')).to.eql(3);",
              "  pm.expect(count('RECONCILIATION_ADJUSTMENT')).to.eql(2);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/atms/{{atmId}}/movements"
      }
    },
    {
      "name": "12 Ledger: consistency check",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Stored balances match the ledger', () => {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(pm.response.json().isConsistent).to.eql(true);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/ledger/consistency?atmId={{atmId}}"
      }
    },
    {
      "name": "Error examples",
      "item": [
        {
          "name": "Invalid state transition (MAINTENANCE → LOADED)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Rejected with INVALID_STATE_TRANSITION', () => {",
                  "  pm.response.to.have.status(409);",
                  "  pm.expect(pm.response.json().errorCode).to.eql('INVALID_STATE_TRANSITION');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"LOADED\"\n}"
            },
            "url": "{{baseUrl}}/api/atms/{{atmId}}/status"
          }
        },
        {
          "name": "Cash cannot be loaded into the deposit cassette",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Rejected with CASSETTE_NOT_LOADABLE', () => {",
                  "  pm.response.to.have.status(422);",
                  "  pm.expect(pm.response.json().errorCode).to.eql('CASSETTE_NOT_LOADABLE');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [ { \"slot\": 1, \"count\": 10 } ]\n}"
            },
            "url": "{{baseUrl}}/api/atms/{{atmId}}/cash-loads"
          }
        },
        {
          "name": "Configuration without a foreign currency cassette",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Rejected with FOREIGN_CURRENCY_CASSETTE_COUNT_INVALID', () => {",
                  "  pm.response.to.have.status(422);",
                  "  pm.expect(pm.response.json().errorCode).to.eql('FOREIGN_CURRENCY_CASSETTE_COUNT_INVALID');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cassettes\": [\n    { \"slot\": 1, \"type\": \"DEPOSIT\" },\n    { \"slot\": 2, \"type\": \"RECYCLING\", \"currency\": \"TRY\", \"denomination\": 100 },\n    { \"slot\": 3, \"type\": \"RECYCLING\", \"currency\": \"TRY\", \"denomination\": 50 },\n    { \"slot\": 4, \"type\": \"RECYCLING\", \"currency\": \"TRY\", \"denomination\": 20 },\n    { \"slot\": 5, \"type\": \"RECYCLING\", \"currency\": \"TRY\", \"denomination\": 500 }\n  ]\n}"
            },
            "url": "{{baseUrl}}/api/atms/{{atmId}}/cassettes"
          }
        },
        {
          "name": "Confirming without an Idempotency-Key",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Rejected as a malformed request', () => {",
                  "  pm.response.to.have.status(400);",
                  "  pm.expect(pm.response.json().errorCode).to.eql('VALIDATION_FAILED');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"option\": \"EXACT\"\n}"
            },
            "url": "{{baseUrl}}/api/withdrawal-quotes/{{quoteId}}/confirm"
          }
        }
      ]
    }
  ]
}
